<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid Margin="32,20,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============================================================= -->
        <!-- VIEW HEADER                                                    -->
        <!-- ============================================================= -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Breadcrumb + Title + Subtitle -->
            <StackPanel Grid.Column="0">
                <TextBlock Text="COURSES &#x2014; STAGE 2 &#x2014; VERIFIED STUDENTS"
                           FontFamily="IBM Plex Mono, Consolas"
                           FontSize="11"
                           FontWeight="Medium"
                           Foreground="{DynamicResource SageBrush}"
                           Margin="0,0,0,4"/>
                <TextBlock Text="Verified Students Roster &amp; Audit"
                           FontFamily="Segoe UI, Inter, sans-serif"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="#FFFFFF"/>
                <TextBlock Text="Review verified student credentials, manage unapprovals, or inspect individual certificates."
                           FontSize="12"
                           Foreground="{DynamicResource MutedBrush}"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Right: Verified Count Badge + Back Button -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{DynamicResource Panel2Brush}"
                        BorderBrush="{DynamicResource SageBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,6"
                        Margin="0,0,12,0">
                    <TextBlock x:Name="TxtExamVerifiedHeaderCount"
                               Text="0 Verified"
                               FontFamily="IBM Plex Mono, Consolas"
                               FontSize="12"
                               Foreground="{DynamicResource SageBrush}"/>
                </Border>
                <Button x:Name="BtnBackToStage2FromVerified"
                        Content="&#x2190; Back to Stage 2"
                        Style="{DynamicResource BtnSecondary}"
                        Padding="14,8"/>
            </StackPanel>
        </Grid>

        <!-- Main Body: Mode A (Overview) vs Mode B (Student Detail) -->
        <Grid Grid.Row="1">

            <!-- ============================================================= -->
            <!-- MODE A: Student List Overview with Mini Dashboard             -->
            <!-- ============================================================= -->
            <Grid x:Name="ExamVerifiedQueueOverviewPanel" Visibility="Visible">
                <Grid.RowDefinitions>
                    <!-- Mini Dashboard Row -->
                    <RowDefinition Height="Auto"/>
                    <!-- Push Action Bar Row -->
                    <RowDefinition Height="Auto"/>
                    <!-- Student List Table Row -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ========================================================= -->
                <!-- 1. Mini Dashboard: Passed, Failed, New Changes            -->
                <!-- ========================================================= -->
                <Border Grid.Row="0"
                        Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="16,14"
                        Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="VERIFICATION SUMMARY"
                                   FontFamily="IBM Plex Mono, Consolas"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource MutedBrush}"
                                   Margin="0,0,0,10"/>

                        <!-- 3 Mini Dashboard Cards -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Card 1: PASSED STUDENTS (Exam >= 30) -->
                            <Border Grid.Column="0"
                                    Background="{DynamicResource Panel2Brush}"
                                    BorderBrush="{DynamicResource SageBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16,12">
                                <StackPanel>
                                    <TextBlock Text="PASSED STUDENTS"
                                               FontFamily="IBM Plex Mono, Consolas"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource SageBrush}"
                                               Margin="0,0,0,4"/>
                                    <TextBlock x:Name="TxtExamVerifiedPassed"
                                               Text="0"
                                               FontFamily="IBM Plex Mono, Consolas"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource SageBrush}"/>
                                    <TextBlock Text="Exam marks &#x2265; 30 / 75"
                                               FontSize="11"
                                               Foreground="{DynamicResource MutedBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 2: FAILED STUDENTS (Exam < 30) -->
                            <Border Grid.Column="2"
                                    Background="{DynamicResource Panel2Brush}"
                                    BorderBrush="{DynamicResource DangerBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16,12">
                                <StackPanel>
                                    <TextBlock Text="FAILED STUDENTS"
                                               FontFamily="IBM Plex Mono, Consolas"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource DangerBrush}"
                                               Margin="0,0,0,4"/>
                                    <TextBlock x:Name="TxtExamVerifiedFailed"
                                               Text="0"
                                               FontFamily="IBM Plex Mono, Consolas"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource DangerBrush}"/>
                                    <TextBlock Text="Exam marks &lt; 30 / 75"
                                               FontSize="11"
                                               Foreground="{DynamicResource MutedBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 3: NEW CHANGES (Staged unapprovals/edits in session) -->
                            <Border Grid.Column="4"
                                    Background="{DynamicResource Panel2Brush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16,12"
                                    x:Name="CardExamVerifiedNewChanges">
                                <StackPanel>
                                    <TextBlock Text="NEW CHANGES"
                                               FontFamily="IBM Plex Mono, Consolas"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MutedBrush}"
                                               Margin="0,0,0,4"
                                               x:Name="TxtExamVerifiedNewChangesLabel"/>
                                    <TextBlock x:Name="TxtExamVerifiedNewChanges"
                                               Text="0"
                                               FontFamily="IBM Plex Mono, Consolas"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="Click Push to sync with sheet"
                                               FontSize="11"
                                               Foreground="{DynamicResource MutedBrush}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ========================================================= -->
                <!-- 2. Push Action Bar (No Email button)                       -->
                <!-- ========================================================= -->
                <Border Grid.Row="1"
                        Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="16,10"
                        Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Push Button -->
                        <Button x:Name="BtnPushExamVerifiedChanges"
                                Grid.Column="0"
                                Content="Push Changes to Result Sheet"
                                Style="{DynamicResource BtnPrimary}"
                                Background="{DynamicResource SageBrush}"
                                Padding="18,8"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                IsEnabled="False"/>

                        <!-- Status Text -->
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="16,0,0,0">
                            <TextBlock x:Name="TxtExamVerifiedPushStatus"
                                       Text="No pending changes in this session"
                                       FontFamily="IBM Plex Mono, Consolas"
                                       FontSize="11"
                                       Foreground="{DynamicResource MutedBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ========================================================= -->
                <!-- 3. Student List Table                                      -->
                <!-- ========================================================= -->
                <Border Grid.Row="2"
                        Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="16,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Table Header + Search (Row 0) -->
                            <RowDefinition Height="Auto"/>
                            <!-- Column Titles (Row 1) -->
                            <RowDefinition Height="Auto"/>
                            <!-- Rows ScrollViewer (Row 2) -->
                            <RowDefinition Height="*"/>
                            <!-- Pagination Bar (Row 3) -->
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Table Header & Search Filter Bar -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="280"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="STUDENT LIST"
                                       FontFamily="IBM Plex Mono, Consolas"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource MutedBrush}"
                                       VerticalAlignment="Center"/>

                            <TextBlock x:Name="TxtExamVerifiedPageRange"
                                       Grid.Column="1"
                                       Text=""
                                       FontFamily="IBM Plex Mono, Consolas"
                                       FontSize="11"
                                       Foreground="{DynamicResource Muted2Brush}"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0"/>

                            <!-- Marks Legend Capsule (A / E / T) -->
                            <Border Grid.Column="2"
                                    Background="{DynamicResource Panel2Brush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12,5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#x2139;"
                                               FontSize="11"
                                               Foreground="{DynamicResource AccentBrush}"
                                               Margin="0,0,6,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="A: Assign (/25)  &#x2022;  E: Exam (/75, Pass &#x2265; 30)  &#x2022;  T: Total (/100)"
                                               FontFamily="IBM Plex Mono, Consolas"
                                               FontSize="11"
                                               Foreground="{DynamicResource MutedBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Search Filter Box -->
                            <Border Grid.Column="3"
                                    Background="{DynamicResource Panel2Brush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,5"
                                    VerticalAlignment="Center">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Search Icon -->
                                    <TextBlock Grid.Column="0"
                                               Text="&#x1F50D;"
                                               FontSize="10"
                                               Foreground="{DynamicResource MutedBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>

                                    <TextBox x:Name="TxtExamVerifiedSearch"
                                             Grid.Column="1"
                                             Background="Transparent"
                                             Foreground="{DynamicResource TextBrush}"
                                             BorderThickness="0"
                                             Padding="0"
                                             FontSize="11"
                                             VerticalAlignment="Center"
                                             CaretBrush="{DynamicResource SageBrush}"/>

                                    <!-- Placeholder Text -->
                                    <TextBlock x:Name="TxtExamVerifiedSearchPlaceholder"
                                               Grid.Column="1"
                                               Text="Search roll no or name..."
                                               FontSize="11"
                                               Foreground="{DynamicResource Muted2Brush}"
                                               IsHitTestVisible="False"
                                               VerticalAlignment="Center"/>

                                    <!-- Clear Search Button -->
                                    <Button x:Name="BtnClearExamVerifiedSearch"
                                            Grid.Column="2"
                                            Content="&#x2715;"
                                            Background="Transparent"
                                            Foreground="{DynamicResource MutedBrush}"
                                            BorderThickness="0"
                                            Padding="4,0"
                                            FontSize="10"
                                            Cursor="Hand"
                                            Visibility="Collapsed"
                                            ToolTip="Clear search"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Column Titles Header -->
                        <Border Grid.Row="1"
                                Background="{DynamicResource Panel2Brush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="14,10"
                                Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="190"/>
                                    <ColumnDefinition Width="190"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="ENROLLMENT"
                                           FontFamily="IBM Plex Mono, Consolas"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource MutedBrush}"/>
                                <TextBlock Grid.Column="1"
                                           Text="STUDENT NAME"
                                           FontFamily="IBM Plex Mono, Consolas"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource MutedBrush}"/>
                                <TextBlock Grid.Column="2"
                                           Text="CERTIFICATE (A / E / T)"
                                           FontFamily="IBM Plex Mono, Consolas"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource SageBrush}"
                                           ToolTip="A: Assignment Marks (/25)&#x0A;E: Proctored Exam Marks (/75, Passing &#x2265; 30)&#x0A;T: Total Marks (/100)"/>
                                <TextBlock Grid.Column="3"
                                           Text="SUBMITTED (A / E / T)"
                                           FontFamily="IBM Plex Mono, Consolas"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource MutedBrush}"
                                           ToolTip="Marks declared by student in registration form:&#x0A;A: Assignment (/25)&#x0A;E: Exam (/75)&#x0A;T: Total (/100)"/>
                                <TextBlock Grid.Column="4"
                                           Text="STATUS &amp; ACTIONS"
                                           FontFamily="IBM Plex Mono, Consolas"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource MutedBrush}"
                                           HorizontalAlignment="Right"
                                           Margin="0,0,10,0"/>
                            </Grid>
                        </Border>

                        <!-- Table Rows Host -->
                        <ScrollViewer x:Name="ExamVerifiedRowsScrollViewer" Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <StackPanel x:Name="ExamVerifiedRowsHost"/>

                                <!-- Empty State Notice -->
                                <Border x:Name="ExamVerifiedEmptyStateNotice"
                                        Background="{DynamicResource Panel2Brush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="24,32"
                                        Visibility="Collapsed">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock x:Name="TxtExamVerifiedEmptyTitle"
                                                   Text="No Verified Students"
                                                   FontFamily="IBM Plex Mono, Consolas"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,6"/>
                                        <TextBlock x:Name="TxtExamVerifiedEmptySub"
                                                   Text="No students with Verified status found. Run the OCR pipeline to verify student certificate records."
                                                   FontSize="12"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Pagination Bar -->
                        <Border Grid.Row="3"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,1,0,0"
                                Padding="4,12,4,2"
                                Margin="0,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left: Summary info -->
                                <TextBlock x:Name="TxtExamVerifiedFooterInfo"
                                           Grid.Column="0"
                                           Text="Page 1 of 1"
                                           FontFamily="IBM Plex Mono, Consolas"
                                           FontSize="11"
                                           Foreground="{DynamicResource Muted2Brush}"
                                           VerticalAlignment="Center"/>

                                <!-- Right: Prev / Next Controls -->
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Button x:Name="BtnExamVerifiedPrevPage"
                                            Content="&#x2190; Previous"
                                            Style="{DynamicResource BtnSecondary}"
                                            Padding="12,5"
                                            FontSize="11"
                                            Margin="0,0,8,0"
                                            Cursor="Hand"/>

                                    <Border Background="{DynamicResource Panel2Brush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="10,4"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtExamVerifiedPageBadge"
                                                   Text="1 / 1"
                                                   FontFamily="IBM Plex Mono, Consolas"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SageBrush}"/>
                                    </Border>

                                    <Button x:Name="BtnExamVerifiedNextPage"
                                            Content="Next &#x2192;"
                                            Style="{DynamicResource BtnSecondary}"
                                            Padding="12,5"
                                            FontSize="11"
                                            Cursor="Hand"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ============================================================= -->
            <!-- MODE B: Student Detail Inspection Workspace                   -->
            <!-- ============================================================= -->
            <Grid x:Name="ExamVerifiedStudentDetailPanel" Visibility="Collapsed">
                <Border Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="20">
                    <Grid x:Name="ExamVerifiedWorkspaceGrid">
                        <Grid.RowDefinitions>
                            <!-- Header Row: Student Identity + Actions -->
                            <RowDefinition Height="Auto"/>
                            <!-- Split-Screen Body -->
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header Row -->
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Back to Student List Button -->
                            <Button x:Name="BtnBackToExamVerifiedTable"
                                    Grid.Column="0"
                                    Content="&#x2190; Back to Student List"
                                    Style="{DynamicResource BtnSecondary}"
                                    Padding="12,7"
                                    FontSize="12"
                                    Cursor="Hand"
                                    Margin="0,0,16,0"/>

                            <!-- Student Identity -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,3">
                                    <TextBlock x:Name="TxtExamVerifiedDetailStudentName"
                                               Text="Student Name"
                                               FontFamily="IBM Plex Mono, Consolas"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"
                                               Margin="0,0,10,0"/>
                                    <Border x:Name="BadgeExamVerifiedDetailStatus"
                                            Background="{DynamicResource SageTintBrush}"
                                            BorderBrush="{DynamicResource SageBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="8,2"
                                            VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtExamVerifiedDetailStatus"
                                                   Text="VERIFIED"
                                                   FontFamily="IBM Plex Mono, Consolas"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource SageBrush}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="TxtExamVerifiedDetailStudentRoll"
                                           Text="Roll No: &#x2014;"
                                           FontFamily="IBM Plex Mono, Consolas"
                                           FontSize="12"
                                           Foreground="{DynamicResource MutedBrush}"/>
                            </StackPanel>

                            <!-- Coordinator Action: Unapprove -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnUnapproveFromExamVerifiedDetail"
                                        Content="&#x21BA; Unapprove Student"
                                        Style="{DynamicResource BtnPrimary}"
                                        Background="{DynamicResource SageBrush}"
                                        Foreground="{DynamicResource BgBrush}"
                                        Padding="16,8"
                                        FontSize="12"
                                        Cursor="Hand"
                                        ToolTip="Move this student back to Under Review for re-inspection"/>
                            </StackPanel>
                        </Grid>

                        <!-- Split-Screen Body -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <!-- Left: Student Info & Marks -->
                                <ColumnDefinition Width="380"/>
                                <ColumnDefinition Width="14"/>
                                <!-- Right: Certificate Viewer -->
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left Column: Details, Marks Comparison, Submission Record -->
                            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="0,0,6,0">

                                    <!-- Audit Diagnostics Box -->
                                    <Border Background="{DynamicResource Panel2Brush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="14"
                                            Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="VERIFICATION RECORD"
                                                       FontFamily="IBM Plex Mono, Consolas"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource SageBrush}"
                                                       Margin="0,0,0,6"/>
                                            <Border Background="{DynamicResource SageTintBrush}"
                                                    BorderBrush="{DynamicResource SageBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="10,8"
                                                    Margin="0,0,0,8">
                                                <TextBlock x:Name="TxtExamVerifiedDetailRemarks"
                                                           Text="Verification remarks will appear here."
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           TextWrapping="Wrap"
                                                           LineHeight="17"/>
                                            </Border>
                                            <TextBlock Text="Audit comparing declared values from the Google Form response against the certificate on the right."
                                                       FontSize="11"
                                                       Foreground="{DynamicResource MutedBrush}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Academic Marks Comparison Card -->
                                    <Border Background="{DynamicResource Panel2Brush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="14"
                                            Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="ACADEMIC MARKS COMPARISON"
                                                       FontFamily="IBM Plex Mono, Consolas"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource MutedBrush}"
                                                       Margin="0,0,0,10"/>

                                            <!-- Comparison Table Header -->
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="CRITERIA" FontSize="9" FontWeight="Bold" FontFamily="IBM Plex Mono" Foreground="{DynamicResource MutedBrush}"/>
                                                <TextBlock Grid.Column="1" Text="DECLARED" FontSize="9" FontWeight="Bold" FontFamily="IBM Plex Mono" Foreground="{DynamicResource MutedBrush}"/>
                                                <TextBlock Grid.Column="2" Text="CERTIFICATE" FontSize="9" FontWeight="Bold" FontFamily="IBM Plex Mono" Foreground="{DynamicResource SageBrush}"/>
                                            </Grid>

                                            <!-- Row: Course -->
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Course" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="TxtExamVerifiedDeclCourse" Grid.Column="1" Text="&#x2014;" FontSize="11" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" Margin="0,0,4,0"/>
                                                <TextBlock x:Name="TxtExamVerifiedCertCourse" Grid.Column="2" Text="&#x2014;" FontSize="11" Foreground="{DynamicResource SageBrush}" TextWrapping="Wrap"/>
                                            </Grid>

                                            <!-- Row: Candidate Name -->
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Name" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="TxtExamVerifiedDeclName" Grid.Column="1" Text="&#x2014;" FontSize="11" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" Margin="0,0,4,0"/>
                                                <TextBlock x:Name="TxtExamVerifiedCertName" Grid.Column="2" Text="&#x2014;" FontSize="11" Foreground="{DynamicResource SageBrush}" TextWrapping="Wrap"/>
                                            </Grid>

                                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,4,0,8"/>

                                            <!-- Row: Assignment /25 -->
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Assign (/25)" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="TxtExamVerifiedDeclAssign" Grid.Column="1" Text="&#x2014;" FontFamily="IBM Plex Mono" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                                <TextBlock x:Name="TxtExamVerifiedCertAssign" Grid.Column="2" Text="&#x2014;" FontFamily="IBM Plex Mono" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SageBrush}"/>
                                            </Grid>

                                            <!-- Row: Exam /75 -->
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Exam (/75)" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="TxtExamVerifiedDeclExam" Grid.Column="1" Text="&#x2014;" FontFamily="IBM Plex Mono" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock x:Name="TxtExamVerifiedCertExam" Text="&#x2014;" FontFamily="IBM Plex Mono" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SageBrush}" Margin="0,0,6,0"/>
                                                    <Border x:Name="BadgeExamVerifiedPassFail"
                                                            Background="{DynamicResource SageTintBrush}"
                                                            BorderBrush="{DynamicResource SageBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="3"
                                                            Padding="5,1"
                                                            VerticalAlignment="Center">
                                                        <TextBlock x:Name="TxtExamVerifiedPassFail"
                                                                   Text="PASS"
                                                                   FontFamily="IBM Plex Mono, Consolas"
                                                                   FontSize="9"
                                                                   FontWeight="Bold"
                                                                   Foreground="{DynamicResource SageBrush}"/>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Row: Total /100 -->
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Total (/100)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="TxtExamVerifiedDeclTotal" Grid.Column="1" Text="&#x2014;" FontFamily="IBM Plex Mono" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                                                <TextBlock x:Name="TxtExamVerifiedCertTotal" Grid.Column="2" Text="&#x2014;" FontFamily="IBM Plex Mono" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource SageBrush}"/>
                                            </Grid>

                                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,8"/>

                                            <!-- Row: NPTEL Roll No -->
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="NPTEL Roll No" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                                                <TextBlock x:Name="TxtExamVerifiedCertRoll" Grid.Column="1" Text="&#x2014;" FontFamily="IBM Plex Mono" FontSize="11" Foreground="{DynamicResource TextBrush}"/>
                                            </Grid>

                                            <!-- Row: Credits -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Credits" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                                                <TextBlock x:Name="TxtExamVerifiedCertCredits" Grid.Column="1" Text="&#x2014;" FontFamily="IBM Plex Mono" FontSize="11" Foreground="{DynamicResource TextBrush}"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Submission Record Box -->
                                    <Border Background="{DynamicResource Panel2Brush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="14"
                                            Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="SUBMISSION RECORD"
                                                       FontFamily="IBM Plex Mono, Consolas"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource MutedBrush}"
                                                       Margin="0,0,0,10"/>

                                            <TextBlock Text="Email Address" FontSize="10" Foreground="{DynamicResource MutedBrush}"/>
                                            <TextBlock x:Name="TxtExamVerifiedDetailEmail" Text="&#x2014;" FontSize="12" Foreground="{DynamicResource TextBrush}" Margin="0,2,0,8"/>

                                            <TextBlock Text="Submission Timestamp" FontSize="10" Foreground="{DynamicResource MutedBrush}"/>
                                            <TextBlock x:Name="TxtExamVerifiedDetailTimestamp" Text="&#x2014;" FontSize="12" Foreground="{DynamicResource TextBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>

                                </StackPanel>
                            </ScrollViewer>

                            <!-- Right Column: Zoomable Certificate Viewer -->
                            <Border Grid.Column="2"
                                    Background="{DynamicResource Panel2Brush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <!-- Viewer Toolbar -->
                                        <RowDefinition Height="Auto"/>
                                        <!-- Viewer Canvas -->
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- Toolbar -->
                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="STUDENT CERTIFICATE"
                                                       FontFamily="IBM Plex Mono, Consolas"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource MutedBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,10,0"/>
                                            <Border Background="{DynamicResource PanelBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="6,2"
                                                    VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtExamVerifiedCertStatusBadge"
                                                           Text="Saved"
                                                           FontFamily="IBM Plex Mono, Consolas"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource SageBrush}"/>
                                            </Border>
                                        </StackPanel>

                                        <!-- Zoom and File Controls -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button x:Name="BtnExamVerifiedZoomOut"
                                                    Content="-"
                                                    ToolTip="Zoom Out"
                                                    Style="{DynamicResource BtnSecondary}"
                                                    Padding="8,3"
                                                    FontSize="12"
                                                    Margin="0,0,4,0"/>
                                            <Border Background="{DynamicResource PanelBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="8,3"
                                                    Margin="0,0,4,0">
                                                <TextBlock x:Name="TxtExamVerifiedZoomLevel"
                                                           Text="100%"
                                                           FontFamily="IBM Plex Mono, Consolas"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextBrush}"/>
                                            </Border>
                                            <Button x:Name="BtnExamVerifiedZoomIn"
                                                    Content="+"
                                                    ToolTip="Zoom In"
                                                    Style="{DynamicResource BtnSecondary}"
                                                    Padding="8,3"
                                                    FontSize="12"
                                                    Margin="0,0,8,0"/>
                                            <Button x:Name="BtnExamVerifiedZoomFit"
                                                    Content="Fit"
                                                    ToolTip="Fit to Viewport"
                                                    Style="{DynamicResource BtnSecondary}"
                                                    Padding="10,4"
                                                    FontSize="11"
                                                    Margin="0,0,8,0"/>
                                            <Button x:Name="BtnOpenExamVerifiedCertFile"
                                                    Content="&#x2197; Open File"
                                                    ToolTip="Open in default system viewer"
                                                    Style="{DynamicResource BtnSecondary}"
                                                    Padding="12,4"
                                                    FontSize="11"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Canvas Viewport -->
                                    <Grid Grid.Row="1">
                                        <!-- Active Scrollable Zoom Image -->
                                        <ScrollViewer x:Name="ExamVerifiedCertScrollViewer"
                                                      HorizontalScrollBarVisibility="Auto"
                                                      VerticalScrollBarVisibility="Auto"
                                                      Background="#10100E">
                                            <Image x:Name="ImgExamVerifiedCertViewer"
                                                   Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="HighQuality">
                                                <Image.LayoutTransform>
                                                    <ScaleTransform x:Name="ExamVerifiedCertZoomScale" ScaleX="1.0" ScaleY="1.0"/>
                                                </Image.LayoutTransform>
                                            </Image>
                                        </ScrollViewer>

                                        <!-- Missing Certificate Placeholder -->
                                        <Border x:Name="ExamVerifiedCertMissingPanel"
                                                Background="#141412"
                                                Visibility="Collapsed">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="&#x26A0;"
                                                           FontSize="36"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,0,0,8"/>
                                                <TextBlock Text="No Certificate File on Disk"
                                                           FontFamily="IBM Plex Mono, Consolas"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,0,0,4"/>
                                                <TextBlock Text="The certificate file has not been imported or downloaded to data/Courses/&lt;Course&gt;/certificates/."
                                                           FontSize="12"
                                                           Foreground="{DynamicResource MutedBrush}"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,0,0,16"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>

                        </Grid>
                    </Grid>
                </Border>
            </Grid>

        </Grid>
    </Grid>
</UserControl>
