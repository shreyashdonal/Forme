<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid Margin="32,20,32,20">
        <Grid.RowDefinitions>
            <!-- 0: Header with breadcrumb and back button -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Mini Dashboard metric cards -->
            <RowDefinition Height="Auto"/>
            <!-- 2: Main Two-Column Content (Roster + Composer) -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 0. Header Area -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock x:Name="TxtEmailBreadcrumb"
                           Text="COURSES &gt; COURSE NAME &gt; EMAIL OUTREACH"
                           FontFamily="IBM Plex Mono, Consolas"
                           FontSize="11"
                           FontWeight="Medium"
                           Foreground="{DynamicResource AccentBrush}"
                           Margin="0,0,0,4"/>
                <TextBlock Text="Email Center"
                           FontFamily="Segoe UI, Inter, sans-serif"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{DynamicResource Panel2Brush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,6"
                        Margin="0,0,12,0">
                    <TextBlock x:Name="TxtEmailHeaderBadge"
                               Text="0 Selected"
                               FontFamily="IBM Plex Mono, Consolas"
                               FontSize="12"
                               Foreground="{DynamicResource AccentBrush}"/>
                </Border>
                <Button x:Name="BtnBackToReview"
                        Content="← Back to Review"
                        Style="{DynamicResource BtnSecondary}"
                        Padding="14,8"/>
            </StackPanel>
        </Grid>

        <!-- 1. Mini Dashboard Metric Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: FLAGGED -->
            <Border Grid.Column="0"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,12">
                <StackPanel>
                    <TextBlock Text="FLAGGED"
                               FontFamily="IBM Plex Mono, Consolas"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{DynamicResource DangerBrush}"
                               Margin="0,0,0,4"/>
                    <TextBlock x:Name="TxtEmailQueuedCount"
                               Text="0"
                               FontFamily="IBM Plex Mono, Consolas"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}"/>
                </StackPanel>
            </Border>

            <!-- Card 2: NOTIFIED -->
            <Border Grid.Column="2"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,12">
                <StackPanel>
                    <TextBlock Text="NOTIFIED"
                               FontFamily="IBM Plex Mono, Consolas"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{DynamicResource SageBrush}"
                               Margin="0,0,0,4"/>
                    <TextBlock x:Name="TxtEmailNotifiedCount"
                               Text="0"
                               FontFamily="IBM Plex Mono, Consolas"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{DynamicResource SageBrush}"/>
                </StackPanel>
            </Border>

            <!-- Card 3: ISSUES -->
            <Border Grid.Column="4"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,12">
                <StackPanel>
                    <TextBlock Text="ISSUES"
                               FontFamily="IBM Plex Mono, Consolas"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}"
                               Margin="0,0,0,4"/>
                    <TextBlock x:Name="TxtEmailIssuesSummary"
                               Text="No issues detected"
                               FontFamily="IBM Plex Mono, Consolas"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 2. Main Two-Column Work Area -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <!-- Left: Recipient Roster (420px width) -->
                <ColumnDefinition Width="420" MinWidth="340"/>
                <ColumnDefinition Width="16"/>
                <!-- Right: Composer & Preview (* width) -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Column: Recipient Selection Card -->
            <Border Grid.Column="0"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Header & Selection Controls -->
                        <RowDefinition Height="Auto"/>
                        <!-- Recipients List -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Roster Header & Delivery Status Bar -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <!-- Top: Title & Selection Controls -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="RECIPIENTS"
                                       FontFamily="IBM Plex Mono, Consolas"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource MutedBrush}"
                                       VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="BtnSelectAllRecipients"
                                        Content="Select All"
                                        Style="{DynamicResource BtnSecondary}"
                                        Padding="10,4"
                                        FontSize="11"
                                        Margin="0,0,6,0"/>
                                <Button x:Name="BtnDeselectAllRecipients"
                                        Content="Clear All"
                                        Style="{DynamicResource BtnSecondary}"
                                        Padding="10,4"
                                        FontSize="11"/>
                            </StackPanel>
                        </Grid>

                        <!-- Bottom: Manual Delivery Status Actions -->
                        <Border Background="{DynamicResource Panel2Brush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="DELIVERY STATUS"
                                           FontFamily="IBM Plex Mono, Consolas"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource MutedBrush}"
                                           VerticalAlignment="Center"/>

                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button x:Name="BtnMarkSelectedNotified"
                                            Content="✓ Mark Notified"
                                            Style="{DynamicResource BtnSecondary}"
                                            Padding="10,4"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource SageBrush}"
                                            Margin="0,0,6,0"
                                            ToolTip="Mark selected students as Notified with current timestamp"/>
                                    <Button x:Name="BtnUnmarkSelectedNotified"
                                            Content="↺ Unmark"
                                            Style="{DynamicResource BtnSecondary}"
                                            Padding="10,4"
                                            FontSize="11"
                                            ToolTip="Reset selected students to unnotified status if send failed or was cancelled"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Recipients ScrollViewer -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <!-- Empty State Notice -->
                            <Border x:Name="EmailEmptyStateNotice"
                                    Background="{DynamicResource Panel2Brush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="24,32"
                                    Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="✓ All Clear"
                                               FontFamily="IBM Plex Mono, Consolas"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource SageBrush}"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,8"/>
                                    <TextBlock Text="No students are currently flagged for review in this course."
                                               FontSize="12"
                                               Foreground="{DynamicResource MutedBrush}"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Dynamic Cards Container -->
                            <StackPanel x:Name="EmailRecipientsHost"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Right Column: Notice Composer & Preview -->
            <Border Grid.Column="2"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Top Header & Template Selector -->
                        <RowDefinition Height="Auto"/>
                        <!-- Subject Line -->
                        <RowDefinition Height="Auto"/>
                        <!-- Notice Body Preview -->
                        <RowDefinition Height="*"/>
                        <!-- Dispatch Action Bar -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 1. Header & Notice Type Tabs -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="NOTICE COMPOSER"
                                   FontFamily="IBM Plex Mono, Consolas"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource MutedBrush}"
                                   VerticalAlignment="Center"/>

                        <!-- Two Functions: Standard Rule-Based Template vs Custom Draft Mail -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="BtnTplStandardRuleNotice"
                                    Content="📋 Standard (5 Rules)"
                                    Style="{DynamicResource BtnNavActive}"
                                    Padding="14,6"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Margin="0,0,8,0"
                                    ToolTip="Auto-fill complete 5-point verification rules checklist requiring receipt resubmission"/>
                            <Button x:Name="BtnTplCustomDraft"
                                    Content="✏️ Custom Draft"
                                    Style="{DynamicResource BtnNav}"
                                    Padding="14,6"
                                    FontSize="11"
                                    ToolTip="Compose custom announcement or instructions (e.g. Google Form link, lab submission schedule)"/>
                        </StackPanel>
                    </Grid>

                    <!-- 2. Subject Line Box -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,12">
                        <TextBlock Text="SUBJECT"
                                   FontFamily="IBM Plex Mono, Consolas"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource MutedBrush}"
                                   Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtEmailSubject"
                                 Style="{DynamicResource InputDark}"
                                 Text="[ACTION REQUIRED] NPTEL Exam Registration Receipt Verification Failed"
                                 FontFamily="Segoe UI, Inter, sans-serif"
                                 FontSize="13"
                                 FontWeight="SemiBold"/>
                    </StackPanel>

                    <!-- 3. Notice Body Preview (Monospace, scrollable) -->
                    <Grid Grid.Row="2" Margin="0,0,0,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="MESSAGE"
                                   FontFamily="IBM Plex Mono, Consolas"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource MutedBrush}"
                                   Margin="0,0,0,4"/>

                        <TextBox x:Name="TxtEmailBodyPreview"
                                 Grid.Row="1"
                                 Style="{DynamicResource InputDark}"
                                 FontFamily="Consolas, IBM Plex Mono, monospace"
                                 FontSize="12"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top"
                                 Padding="12"/>
                    </Grid>

                    <!-- 4. Dispatch Action Bar -->
                    <Border Grid.Row="3"
                            Background="{DynamicResource Panel2Brush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <!-- Quick Copy Actions -->
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <!-- Primary Dispatch Action -->
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnCopyNoticeText"
                                        Content="📋 Copy Notice"
                                        Style="{DynamicResource BtnSecondary}"
                                        Padding="14,8"
                                        FontSize="12"
                                        Margin="0,0,8,0"
                                        ToolTip="Copy formatted message to clipboard (for WhatsApp, Telegram, or Circulars)"/>
                                <Button x:Name="BtnCopyBccEmails"
                                        Content="📋 Copy BCC Emails"
                                        Style="{DynamicResource BtnSecondary}"
                                        Padding="14,8"
                                        FontSize="12"
                                        ToolTip="Copy comma-separated list of selected student email addresses"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnLaunchGmailDraft"
                                        Content="✉ Open in Gmail"
                                        Style="{DynamicResource BtnPrimary}"
                                        Padding="18,8"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        ToolTip="Open official Gmail Web Compose in default browser with BCC recipients, subject, and notice body pre-filled"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
