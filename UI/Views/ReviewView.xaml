<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid Margin="32,20,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- View Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock x:Name="TxtReviewBreadcrumb"
                           Text="COURSES > REVIEW QUEUE"
                           FontFamily="IBM Plex Mono, Consolas"
                           FontSize="11"
                           FontWeight="Medium"
                           Foreground="{DynamicResource AccentBrush}"
                           Margin="0,0,0,4"/>
                <TextBlock Text="Review Submissions with Issues"
                           FontFamily="Segoe UI, Inter, sans-serif"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="#FFFFFF"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{DynamicResource Panel2Brush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,6"
                        Margin="0,0,12,0">
                    <TextBlock x:Name="TxtReviewCountBadge"
                               Text="0 Students Need Review"
                               FontFamily="IBM Plex Mono, Consolas"
                               FontSize="12"
                               Foreground="{DynamicResource MutedBrush}"/>
                </Border>
                <Button x:Name="BtnBackToStage1"
                        Content="← Back to Stage 1"
                        Style="{DynamicResource BtnSecondary}"
                        Padding="14,8"/>
            </StackPanel>
        </Grid>

        <!-- Main Body: Mode A (Queue Overview) vs Mode B (Student Detail) -->
        <Grid Grid.Row="1">

            <!-- ============================================================= -->
            <!-- MODE A: Review Queue Overview Table with Mini Dashboard       -->
            <!-- ============================================================= -->
            <Grid x:Name="ReviewQueueOverviewPanel" Visibility="Visible">
                <Grid.RowDefinitions>
                    <!-- Mini Dashboard Row -->
                    <RowDefinition Height="Auto"/>
                    <!-- Push Action Bar Row -->
                    <RowDefinition Height="Auto"/>
                    <!-- Queue Table Row -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 1. Mini Dashboard: Review Progress -->
                <Border Grid.Row="0"
                        Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="16,14"
                        Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="REVIEW PROGRESS"
                                   FontFamily="IBM Plex Mono, Consolas"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource MutedBrush}"
                                   Margin="0,0,0,10"/>

                        <!-- 3 Mini Dashboard Cards -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Card 1: TOTAL ISSUES -->
                            <Border Grid.Column="0"
                                    Background="{DynamicResource Panel2Brush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16,12">
                                <StackPanel>
                                    <TextBlock Text="TOTAL ISSUES"
                                               FontFamily="IBM Plex Mono, Consolas"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}"
                                               Margin="0,0,0,4"/>
                                    <TextBlock x:Name="TxtReviewTotalIssues"
                                               Text="0"
                                               FontFamily="IBM Plex Mono, Consolas"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="Flagged in verification"
                                               FontSize="11"
                                               Foreground="{DynamicResource MutedBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 2: SOLVED IN THIS SESSION -->
                            <Border Grid.Column="2"
                                    Background="{DynamicResource Panel2Brush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16,12">
                                <StackPanel>
                                    <TextBlock Text="SOLVED IN THIS SESSION"
                                               FontFamily="IBM Plex Mono, Consolas"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource SageBrush}"
                                               Margin="0,0,0,4"/>
                                    <TextBlock x:Name="TxtReviewSolvedCount"
                                               Text="0"
                                               FontFamily="IBM Plex Mono, Consolas"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource SageBrush}"/>
                                    <TextBlock Text="Approved or resolved"
                                               FontSize="11"
                                               Foreground="{DynamicResource MutedBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 3: PENDING -->
                            <Border Grid.Column="4"
                                    Background="{DynamicResource Panel2Brush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16,12">
                                <StackPanel>
                                    <TextBlock Text="PENDING"
                                               FontFamily="IBM Plex Mono, Consolas"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource DangerBrush}"
                                               Margin="0,0,0,4"/>
                                    <TextBlock x:Name="TxtReviewPendingCount"
                                               Text="0"
                                               FontFamily="IBM Plex Mono, Consolas"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="Awaiting review"
                                               FontSize="11"
                                               Foreground="{DynamicResource MutedBrush}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 2. Push Changes Action Bar -->
                <Border Grid.Row="1"
                        Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="16,10"
                        Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Push Button -->
                        <Button x:Name="BtnPushSolvedChanges"
                                Grid.Column="0"
                                Content="Push Changes to Main Sheet"
                                Style="{DynamicResource BtnPrimary}"
                                Background="{DynamicResource SageBrush}"
                                Padding="18,8"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                IsEnabled="False"/>

                        <!-- Status Indicator -->
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="16,0,0,0">
                            <TextBlock x:Name="TxtPushChangesBadge"
                                       Text="No pending changes in this session"
                                       FontFamily="IBM Plex Mono, Consolas"
                                       FontSize="11"
                                       Foreground="{DynamicResource MutedBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 3. Review Queue Table -->
                <Border Grid.Row="2"
                        Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="16,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Table Header Label -->
                            <RowDefinition Height="Auto"/>
                            <!-- Column Titles -->
                            <RowDefinition Height="Auto"/>
                            <!-- Rows ScrollViewer -->
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="REVIEW QUEUE"
                                   FontFamily="IBM Plex Mono, Consolas"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource MutedBrush}"
                                   Margin="0,0,0,10"/>

                        <!-- Column Titles Header -->
                        <Border Grid.Row="1"
                                Background="{DynamicResource Panel2Brush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="14,10"
                                Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="ENROLLMENT"
                                           FontFamily="IBM Plex Mono, Consolas"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource MutedBrush}"/>
                                <TextBlock Grid.Column="1"
                                           Text="STUDENT NAME"
                                           FontFamily="IBM Plex Mono, Consolas"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource MutedBrush}"/>
                                <TextBlock Grid.Column="2"
                                           Text="QUICK ACTIONS"
                                           FontFamily="IBM Plex Mono, Consolas"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource MutedBrush}"
                                           HorizontalAlignment="Right"
                                           Margin="0,0,10,0"/>
                            </Grid>
                        </Border>

                        <!-- Table Rows Host -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <StackPanel x:Name="ReviewRowsHost"/>

                                <!-- Empty State Notice -->
                                <Border x:Name="ReviewEmptyStateNotice"
                                        Background="{DynamicResource Panel2Brush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="24,32"
                                        Visibility="Collapsed">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="Queue is Clear"
                                                   FontFamily="IBM Plex Mono, Consolas"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,6"/>
                                        <TextBlock Text="No student submissions currently require manual review."
                                                   FontSize="12"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- ============================================================= -->
            <!-- MODE B: Student Detail Inspection Workspace                   -->
            <!-- ============================================================= -->
            <Grid x:Name="ReviewStudentDetailPanel" Visibility="Collapsed">
                <Border Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="20">
                    <Grid x:Name="ReviewWorkspaceGrid">
                        <Grid.RowDefinitions>
                            <!-- Header Row: Student Identity & Actions -->
                            <RowDefinition Height="Auto"/>
                            <!-- Split-Screen Body: Details on Left, Receipt on Right -->
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header Row -->
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Back to Queue Table Button -->
                            <Button x:Name="BtnBackToQueueTable"
                                    Grid.Column="0"
                                    Content="← Back to Queue"
                                    Style="{DynamicResource BtnSecondary}"
                                    Padding="12,7"
                                    FontSize="12"
                                    Cursor="Hand"
                                    Margin="0,0,16,0"/>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,3">
                                    <TextBlock x:Name="TxtReviewStudentName"
                                               Text="Student Name"
                                               FontFamily="IBM Plex Mono, Consolas"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"
                                               Margin="0,0,10,0"/>
                                    <Border x:Name="BadgeReviewStatus"
                                            Background="{DynamicResource AccentTintBrush}"
                                            BorderBrush="{DynamicResource AccentBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="8,2"
                                            VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtReviewStatus"
                                                   Text="UNDER REVIEW"
                                                   FontFamily="IBM Plex Mono, Consolas"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentBrush}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="TxtReviewStudentRoll"
                                           Text="Roll No: 0801CS221000"
                                           FontFamily="IBM Plex Mono, Consolas"
                                           FontSize="12"
                                           Foreground="{DynamicResource MutedBrush}"/>
                            </StackPanel>

                            <!-- Coordinator Actions -->
                            <StackPanel x:Name="ReviewActionsHost" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnFlagResubmit"
                                        Content="Flag for Resubmit"
                                        Style="{DynamicResource BtnSecondary}"
                                        BorderBrush="{DynamicResource DangerBrush}"
                                        Foreground="{DynamicResource DangerBrush}"
                                        Padding="12,7"
                                        FontSize="12"
                                        Cursor="Hand"
                                        Margin="0,0,10,0"/>

                                <Button x:Name="BtnApproveOverride"
                                        Content="Approve (Override)"
                                        Style="{DynamicResource BtnPrimary}"
                                        Background="{DynamicResource SageBrush}"
                                        Padding="14,7"
                                        FontSize="12"
                                        Cursor="Hand"/>
                            </StackPanel>
                        </Grid>

                        <!-- Split-Screen Body -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <!-- Sub-Column 1: Student Information & Diagnostics (Width: 330) -->
                                <ColumnDefinition Width="330"/>
                                <ColumnDefinition Width="14"/>
                                <!-- Sub-Column 2: Zoomable Receipt Viewer (Flexible) -->
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Sub-Column 1: Student Details & Diagnostics -->
                            <ScrollViewer x:Name="ReviewDetailsScrollViewer" Grid.Column="0" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="0,0,6,0">
                                    <!-- Diagnostics Box -->
                                    <Border Background="{DynamicResource Panel2Brush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="14"
                                            Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="VERIFICATION DIAGNOSTICS"
                                                       FontFamily="IBM Plex Mono, Consolas"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       Margin="0,0,0,6"/>
                                            <Border Background="{DynamicResource AccentTintBrush}"
                                                    BorderBrush="{DynamicResource AccentBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="10,8"
                                                    Margin="0,0,0,8">
                                                <TextBlock x:Name="TxtReviewRemarks"
                                                           Text="Remarks explaining why verification flagged this student."
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           TextWrapping="Wrap"
                                                           LineHeight="17"/>
                                            </Border>
                                            <TextBlock Text="Compare the student's declared course, name, and fee against the receipt shown on the right."
                                                       FontSize="11"
                                                       Foreground="{DynamicResource MutedBrush}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Registration Info Box -->
                                    <Border Background="{DynamicResource Panel2Brush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="14"
                                            Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="REGISTRATION RECORD"
                                                       FontFamily="IBM Plex Mono, Consolas"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource MutedBrush}"
                                                       Margin="0,0,0,10"/>

                                            <TextBlock Text="Email Address"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource MutedBrush}"/>
                                            <TextBlock x:Name="TxtReviewEmail"
                                                       Text="student@college.edu"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       Margin="0,2,0,8"
                                                       TextWrapping="Wrap"/>

                                            <TextBlock Text="Enrolled Course / Subject"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource MutedBrush}"/>
                                            <TextBlock x:Name="TxtReviewSubject"
                                                       Text="Introduction to Soft Computing"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       Margin="0,2,0,8"
                                                       TextWrapping="Wrap"/>

                                            <TextBlock Text="Exam Registration Declared?"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource MutedBrush}"/>
                                            <TextBlock x:Name="TxtReviewIsRegistered"
                                                       Text="Yes"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       Margin="0,2,0,8"/>

                                            <TextBlock Text="Submission Timestamp"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource MutedBrush}"/>
                                            <TextBlock x:Name="TxtReviewTimestamp"
                                                       Text="--"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       Margin="0,2,0,8"/>

                                            <TextBlock Text="Proof URL (Google Drive)"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource MutedBrush}"/>
                                            <TextBlock x:Name="TxtReviewProofUrl"
                                                       Text="https://drive.google.com/..."
                                                       FontSize="11"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       Margin="0,2,0,6"
                                                       TextWrapping="Wrap"/>

                                            <Button x:Name="BtnOpenDriveLink"
                                                     Content="Open Drive Link"
                                                     Style="{DynamicResource BtnSecondary}"
                                                     HorizontalAlignment="Left"
                                                     Padding="10,5"
                                                     FontSize="11"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Manual Receipt Attachment Box (Interactive Action Card) -->
                                    <Border Background="#1C2420"
                                            BorderBrush="{DynamicResource SageBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="14"
                                            Margin="0,0,0,12">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <Border Background="{DynamicResource SageTintBrush}"
                                                        BorderBrush="{DynamicResource SageBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="6,2"
                                                        Margin="0,0,8,0">
                                                    <TextBlock Text="ACTION"
                                                               FontFamily="IBM Plex Mono, Consolas"
                                                               FontSize="9"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource SageBrush}"/>
                                                </Border>
                                                <TextBlock Text="ATTACH STUDENT RECEIPT"
                                                           FontFamily="IBM Plex Mono, Consolas"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="Attach a replacement PDF or image receipt received directly from the student. The system will automatically scan and verify it with OCR."
                                                       FontSize="11"
                                                       Foreground="{DynamicResource MutedBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,10"/>
                                            <Button x:Name="BtnAttachLocalReceipt"
                                                    Content="Attach &amp; Verify Receipt..."
                                                    Style="{DynamicResource BtnPrimary}"
                                                    Background="{DynamicResource SageBrush}"
                                                    HorizontalAlignment="Left"
                                                    Padding="14,7"
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Cursor="Hand"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Sub-Column 2: Zoomable Receipt Viewer -->
                            <Border Grid.Column="2"
                                    Background="{DynamicResource Panel2Brush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <!-- Toolbar -->
                                        <RowDefinition Height="Auto"/>
                                        <!-- Canvas -->
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- Toolbar -->
                                    <Grid Grid.Row="0" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="PAYMENT RECEIPT"
                                                       FontFamily="IBM Plex Mono, Consolas"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource MutedBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0"/>
                                            <TextBlock x:Name="TxtReceiptStatusBadge"
                                                       Text="Saved"
                                                       FontFamily="IBM Plex Mono, Consolas"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource SageBrush}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Zoom & File Controls -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button x:Name="BtnZoomOut"
                                                    Content="-"
                                                    ToolTip="Zoom Out"
                                                    Style="{DynamicResource BtnSecondary}"
                                                    Padding="8,3"
                                                    FontSize="12"
                                                    Margin="0,0,4,0"/>
                                            <Border Background="{DynamicResource PanelBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="8,3"
                                                    Margin="0,0,4,0">
                                                <TextBlock x:Name="TxtZoomLevel"
                                                           Text="100%"
                                                           FontFamily="IBM Plex Mono, Consolas"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextBrush}"/>
                                            </Border>
                                            <Button x:Name="BtnZoomIn"
                                                    Content="+"
                                                    ToolTip="Zoom In"
                                                    Style="{DynamicResource BtnSecondary}"
                                                    Padding="8,3"
                                                    FontSize="12"
                                                    Margin="0,0,8,0"/>
                                            <Button x:Name="BtnZoomFit"
                                                    Content="Fit"
                                                    ToolTip="Fit to Viewport"
                                                    Style="{DynamicResource BtnSecondary}"
                                                    Padding="8,3"
                                                    FontSize="11"
                                                    Margin="0,0,10,0"/>
                                            <Button x:Name="BtnOpenReceiptFile"
                                                    Content="Open File"
                                                    Style="{DynamicResource BtnSecondary}"
                                                    Padding="10,4"
                                                    FontSize="11"
                                                    IsEnabled="False"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Canvas / Image Viewer -->
                                    <Border Grid.Row="1"
                                            Background="#151513"
                                            CornerRadius="6"
                                            ClipToBounds="True">
                                        <Grid>
                                            <!-- Image ScrollViewer -->
                                            <ScrollViewer x:Name="ReceiptScrollViewer"
                                                          HorizontalScrollBarVisibility="Auto"
                                                          VerticalScrollBarVisibility="Auto"
                                                          Visibility="Collapsed">
                                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Image x:Name="ReceiptImage"
                                                           Stretch="Uniform"
                                                           RenderOptions.BitmapScalingMode="HighQuality">
                                                        <Image.LayoutTransform>
                                                            <ScaleTransform x:Name="ReceiptZoomScale" ScaleX="1.0" ScaleY="1.0"/>
                                                        </Image.LayoutTransform>
                                                    </Image>
                                                </Grid>
                                            </ScrollViewer>

                                            <!-- Missing Receipt Placeholder -->
                                            <Border x:Name="ReceiptMissingPlaceholder"
                                                    Visibility="Visible"
                                                    Background="Transparent">
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="Receipt File Not Available"
                                                               FontFamily="IBM Plex Mono, Consolas"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               HorizontalAlignment="Center"
                                                               Margin="0,0,0,6"/>
                                                    <TextBlock x:Name="TxtReceiptMissingMsg"
                                                               Text="The receipt image is not yet cached locally. You can open the Drive link in a browser or download it directly."
                                                               FontSize="11"
                                                               Foreground="{DynamicResource MutedBrush}"
                                                               TextWrapping="Wrap"
                                                               TextAlignment="Center"
                                                               MaxWidth="280"
                                                               Margin="0,0,0,12"/>
                                                    <Button x:Name="BtnDownloadMissingReceipt"
                                                            Content="Try Downloading Receipt"
                                                            Style="{DynamicResource BtnSecondary}"
                                                            HorizontalAlignment="Center"
                                                            Padding="10,5"
                                                            FontSize="11"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Modal Overlay for Flagging Resubmission -->
        <Grid x:Name="ModalFlagResubmit"
              Grid.Row="0"
              Grid.RowSpan="2"
              Margin="-32,-20,-32,-20"
              Visibility="Collapsed"
              Background="#CC151513">
            <Border Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="24"
                    Width="460"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Flag Student for Resubmission"
                               FontFamily="IBM Plex Mono, Consolas"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"
                               Margin="0,0,0,6"/>
                    <TextBlock Text="Enter the reason why this student's receipt requires resubmission. This note will be recorded in the student verification record."
                               FontSize="12"
                               Foreground="{DynamicResource MutedBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,16"/>

                    <TextBlock Text="Quick Preset Reasons:"
                               FontFamily="IBM Plex Mono, Consolas"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{DynamicResource MutedBrush}"
                               Margin="0,0,0,6"/>
                    <WrapPanel Margin="0,0,0,14">
                        <Button x:Name="BtnPresetBlurry"
                                Content="Blurry Receipt"
                                Style="{DynamicResource BtnSecondary}"
                                Padding="8,4"
                                FontSize="11"
                                Margin="0,0,6,6"/>
                        <Button x:Name="BtnPresetWrongCourse"
                                Content="Wrong Course Name"
                                Style="{DynamicResource BtnSecondary}"
                                Padding="8,4"
                                FontSize="11"
                                Margin="0,0,6,6"/>
                        <Button x:Name="BtnPresetDriveAccess"
                                Content="Drive Access Denied"
                                Style="{DynamicResource BtnSecondary}"
                                Padding="8,4"
                                FontSize="11"
                                Margin="0,0,6,6"/>
                        <Button x:Name="BtnPresetFeeIncomplete"
                                Content="Fee Incomplete"
                                Style="{DynamicResource BtnSecondary}"
                                Padding="8,4"
                                FontSize="11"
                                Margin="0,0,6,6"/>
                    </WrapPanel>

                    <TextBlock Text="Coordinator Note / Instructions:"
                               FontFamily="IBM Plex Mono, Consolas"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{DynamicResource MutedBrush}"
                               Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtResubmitReason"
                             Style="{DynamicResource InputDark}"
                             Height="75"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Margin="0,0,0,20"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnCancelFlagModal"
                                Content="Cancel"
                                Style="{DynamicResource BtnSecondary}"
                                Padding="14,8"
                                Margin="0,0,10,0"/>
                        <Button x:Name="BtnConfirmFlagModal"
                                Content="Flag Student"
                                Style="{DynamicResource BtnPrimary}"
                                Background="{DynamicResource DangerBrush}"
                                Padding="16,8"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
