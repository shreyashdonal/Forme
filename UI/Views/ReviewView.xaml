<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid Margin="32,24,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- View Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="STUDENT SUBMISSION REVIEW"
                           FontFamily="IBM Plex Mono, Consolas"
                           FontSize="11"
                           FontWeight="Medium"
                           Foreground="{DynamicResource AccentBrush}"
                           Margin="0,0,0,4"/>
                <TextBlock Text="Review Submissions with Issues"
                           FontFamily="IBM Plex Mono, Consolas"
                           FontSize="24"
                           FontWeight="Medium"
                           Foreground="{DynamicResource TextBrush}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{DynamicResource Panel2Brush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,6">
                    <TextBlock x:Name="TxtReviewCountBadge"
                               Text="0 Students Need Review"
                               FontFamily="IBM Plex Mono, Consolas"
                               FontSize="12"
                               Foreground="{DynamicResource MutedBrush}"/>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Two-column Layout -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Column 1: Students Needing Review -->
            <Border Grid.Column="0"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="Review Queue"
                               FontFamily="IBM Plex Mono, Consolas"
                               FontSize="12"
                               Foreground="{DynamicResource MutedBrush}"
                               Margin="0,0,0,12"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Dynamic items host -->
                            <StackPanel x:Name="ReviewItemsListHost"/>

                            <!-- Empty State Notice -->
                            <Border x:Name="ReviewEmptyStateNotice"
                                    Background="{DynamicResource Panel2Brush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16,24">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Queue is Clear"
                                               FontFamily="IBM Plex Mono, Consolas"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,6"/>
                                    <TextBlock Text="No student submissions currently require manual review."
                                               FontSize="12"
                                               Foreground="{DynamicResource MutedBrush}"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Column 2: Details & Side-by-Side Comparison -->
            <Border Grid.Column="2"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="24">
                <Grid x:Name="ReviewDetailsContainer">
                    <!-- Empty selection placeholder -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440">
                        <Border Background="{DynamicResource Panel2Brush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Width="44" Height="44"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,16">
                            <TextBlock Text="i"
                                       FontFamily="IBM Plex Mono, Consolas"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource MutedBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="No Submission Selected"
                                   FontFamily="IBM Plex Mono, Consolas"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="Select a flagged student submission from the queue on the left to inspect their registration details, compare differences against the master roster, and review their uploaded payment proof."
                                   FontSize="13"
                                   Foreground="{DynamicResource MutedBrush}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
