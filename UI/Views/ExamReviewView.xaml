<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid Margin="32,20,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- View Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock x:Name="TxtExamReviewBreadcrumb"
                           Text="COURSES > STAGE 2 &#x2014; EXAM REVIEW QUEUE"
                           FontFamily="IBM Plex Mono, Consolas"
                           FontSize="11"
                           FontWeight="Medium"
                           Foreground="{DynamicResource AccentBrush}"
                           Margin="0,0,0,4"/>
                <TextBlock Text="Review Examination Results with Issues"
                           FontFamily="Segoe UI, Inter, sans-serif"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="#FFFFFF"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{DynamicResource Panel2Brush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,6"
                        Margin="0,0,12,0">
                    <TextBlock x:Name="TxtExamReviewCountBadge"
                               Text="0 Students Need Review"
                               FontFamily="IBM Plex Mono, Consolas"
                               FontSize="12"
                               Foreground="{DynamicResource MutedBrush}"/>
                </Border>
                <Button x:Name="BtnBackToStage2"
                        Content="&#x2190; Back to Stage 2"
                        Style="{DynamicResource BtnSecondary}"
                        Padding="14,8"/>
            </StackPanel>
        </Grid>

        <!-- Main Body: Mode A (Queue Overview) vs Mode B (Student Detail) -->
        <Grid Grid.Row="1">

            <!-- ============================================================= -->
            <!-- MODE A: Exam Review Queue Overview Table with Mini Dashboard  -->
            <!-- ============================================================= -->
            <Grid x:Name="ExamReviewQueueOverviewPanel" Visibility="Visible">
                <Grid.RowDefinitions>
                    <!-- Mini Dashboard Row -->
                    <RowDefinition Height="Auto"/>
                    <!-- Push Action Bar Row -->
                    <RowDefinition Height="Auto"/>
                    <!-- Queue Table Row -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 1. Mini Dashboard: Review Progress -->
                <Border Grid.Row="0"
                        Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="16,14"
                        Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="EXAM VERIFICATION PROGRESS"
                                   FontFamily="IBM Plex Mono, Consolas"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource MutedBrush}"
                                   Margin="0,0,0,10"/>

                        <!-- 3 Mini Dashboard Cards -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Card 1: TOTAL ISSUES -->
                            <Border Grid.Column="0"
                                    Background="{DynamicResource Panel2Brush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16,12">
                                <StackPanel>
                                    <TextBlock Text="TOTAL ISSUES"
                                               FontFamily="IBM Plex Mono, Consolas"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}"
                                               Margin="0,0,0,4"/>
                                    <TextBlock x:Name="TxtExamReviewTotalIssues"
                                               Text="0"
                                               FontFamily="IBM Plex Mono, Consolas"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="Flagged in certificate audit"
                                               FontSize="11"
                                               Foreground="{DynamicResource MutedBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 2: SOLVED IN THIS SESSION -->
                            <Border Grid.Column="2"
                                    Background="{DynamicResource Panel2Brush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16,12">
                                <StackPanel>
                                    <TextBlock Text="SOLVED IN THIS SESSION"
                                               FontFamily="IBM Plex Mono, Consolas"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource SageBrush}"
                                               Margin="0,0,0,4"/>
                                    <TextBlock x:Name="TxtExamReviewSolvedCount"
                                               Text="0"
                                               FontFamily="IBM Plex Mono, Consolas"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource SageBrush}"/>
                                    <TextBlock Text="Marks accepted / approved"
                                               FontSize="11"
                                               Foreground="{DynamicResource MutedBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 3: PENDING -->
                            <Border Grid.Column="4"
                                    Background="{DynamicResource Panel2Brush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16,12">
                                <StackPanel>
                                    <TextBlock Text="PENDING"
                                               FontFamily="IBM Plex Mono, Consolas"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource DangerBrush}"
                                               Margin="0,0,0,4"/>
                                    <TextBlock x:Name="TxtExamReviewPendingCount"
                                               Text="0"
                                               FontFamily="IBM Plex Mono, Consolas"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="Awaiting coordinator review"
                                               FontSize="11"
                                               Foreground="{DynamicResource MutedBrush}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 2. Action Bar: Push Changes & Student Outreach -->
                <Border Grid.Row="1"
                        Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="16,10"
                        Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Push Button -->
                        <Button x:Name="BtnPushExamSolvedChanges"
                                Grid.Column="0"
                                Content="Push Changes to Result Sheet"
                                Style="{DynamicResource BtnPrimary}"
                                Background="{DynamicResource SageBrush}"
                                Padding="18,8"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                IsEnabled="False"/>

                        <!-- Status Indicator -->
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="16,0,0,0">
                            <TextBlock x:Name="TxtPushExamChangesBadge"
                                       Text="No pending changes in this session"
                                       FontFamily="IBM Plex Mono, Consolas"
                                       FontSize="11"
                                       Foreground="{DynamicResource MutedBrush}"/>
                        </StackPanel>

                        <!-- Send Email to Flagged Students Action Button -->
                        <Button x:Name="BtnNotifyFlaggedExamStudents"
                                Grid.Column="2"
                                Content="&#x2709; Send Email to Flagged Students"
                                Style="{DynamicResource BtnSecondary}"
                                Padding="16,8"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                ToolTip="Open the Email Management Center to notify flagged students"/>
                    </Grid>
                </Border>

                <!-- 3. Review Queue Table -->
                <Border Grid.Row="2"
                        Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="16,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Table Header Label & Search Filter (Row 0) -->
                            <RowDefinition Height="Auto"/>
                            <!-- Column Titles (Row 1) -->
                            <RowDefinition Height="Auto"/>
                            <!-- Rows ScrollViewer (Row 2) -->
                            <RowDefinition Height="*"/>
                            <!-- Pagination Bar (Row 3) -->
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Table Header & Search Filter Bar -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="280"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="EXAM REVIEW QUEUE"
                                       FontFamily="IBM Plex Mono, Consolas"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource MutedBrush}"
                                       VerticalAlignment="Center"/>

                            <TextBlock x:Name="TxtExamReviewPageRange"
                                       Grid.Column="1"
                                       Text=""
                                       FontFamily="IBM Plex Mono, Consolas"
                                       FontSize="11"
                                       Foreground="{DynamicResource Muted2Brush}"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0"/>

                            <!-- Search Filter Input Box -->
                            <Border Grid.Column="3"
                                    Background="{DynamicResource Panel2Brush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,5"
                                    VerticalAlignment="Center">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Search Icon -->
                                    <TextBlock Grid.Column="0"
                                               Text="&#x1F50D;"
                                               FontSize="10"
                                               Foreground="{DynamicResource MutedBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>

                                    <TextBox x:Name="TxtExamReviewSearch"
                                             Grid.Column="1"
                                             Background="Transparent"
                                             Foreground="{DynamicResource TextBrush}"
                                             BorderThickness="0"
                                             Padding="0"
                                             FontSize="11"
                                             VerticalAlignment="Center"
                                             CaretBrush="{DynamicResource AccentBrush}"/>

                                    <!-- Placeholder Text -->
                                    <TextBlock x:Name="TxtExamReviewSearchPlaceholder"
                                               Grid.Column="1"
                                               Text="Search roll no, name, or issue..."
                                               FontSize="11"
                                               Foreground="{DynamicResource Muted2Brush}"
                                               IsHitTestVisible="False"
                                               VerticalAlignment="Center"/>

                                    <!-- Clear Search Button -->
                                    <Button x:Name="BtnClearExamReviewSearch"
                                            Grid.Column="2"
                                            Content="&#x2715;"
                                            Background="Transparent"
                                            Foreground="{DynamicResource MutedBrush}"
                                            BorderThickness="0"
                                            Padding="4,0"
                                            FontSize="10"
                                            Cursor="Hand"
                                            Visibility="Collapsed"
                                            ToolTip="Clear search"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Column Titles Header -->
                        <Border Grid.Row="1"
                                Background="{DynamicResource Panel2Brush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="14,10"
                                Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="ENROLLMENT"
                                           FontFamily="IBM Plex Mono, Consolas"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource MutedBrush}"/>
                                <TextBlock Grid.Column="1"
                                           Text="STUDENT NAME &amp; DISCREPANCIES"
                                           FontFamily="IBM Plex Mono, Consolas"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource MutedBrush}"/>
                                <TextBlock Grid.Column="2"
                                           Text="QUICK ACTIONS"
                                           FontFamily="IBM Plex Mono, Consolas"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource MutedBrush}"
                                           HorizontalAlignment="Right"
                                           Margin="0,0,10,0"/>
                            </Grid>
                        </Border>

                        <!-- Table Rows Host -->
                        <ScrollViewer x:Name="ExamReviewRowsScrollViewer" Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <StackPanel x:Name="ExamReviewRowsHost"/>

                                <!-- Empty State Notice -->
                                <Border x:Name="ExamReviewEmptyStateNotice"
                                        Background="{DynamicResource Panel2Brush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="24,32"
                                        Visibility="Collapsed">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock x:Name="TxtExamReviewEmptyTitle"
                                                   Text="Queue is Clear"
                                                   FontFamily="IBM Plex Mono, Consolas"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,6"/>
                                        <TextBlock x:Name="TxtExamReviewEmptySub"
                                                   Text="All student examination results have been verified or accepted."
                                                   FontSize="12"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Pagination Bar -->
                        <Border Grid.Row="3"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,1,0,0"
                                Padding="4,12,4,2"
                                Margin="0,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left: Summary info -->
                                <TextBlock x:Name="TxtExamReviewFooterInfo"
                                           Grid.Column="0"
                                           Text="Page 1 of 1"
                                           FontFamily="IBM Plex Mono, Consolas"
                                           FontSize="11"
                                           Foreground="{DynamicResource Muted2Brush}"
                                           VerticalAlignment="Center"/>

                                <!-- Right: Prev/Next Controls -->
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Button x:Name="BtnExamReviewPrevPage"
                                            Content="&#x2190; Previous"
                                            Style="{DynamicResource BtnSecondary}"
                                            Padding="12,5"
                                            FontSize="11"
                                            Margin="0,0,8,0"
                                            Cursor="Hand"/>

                                    <Border Background="{DynamicResource Panel2Brush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="10,4"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtExamReviewPageBadge"
                                                   Text="1 / 1"
                                                   FontFamily="IBM Plex Mono, Consolas"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentBrush}"/>
                                    </Border>

                                    <Button x:Name="BtnExamReviewNextPage"
                                            Content="Next &#x2192;"
                                            Style="{DynamicResource BtnSecondary}"
                                            Padding="12,5"
                                            FontSize="11"
                                            Cursor="Hand"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ============================================================= -->
            <!-- MODE B: Student Detail Inspection Workspace                   -->
            <!-- ============================================================= -->
            <Grid x:Name="ExamReviewStudentDetailPanel" Visibility="Collapsed">
                <Border Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="20">
                    <Grid x:Name="ExamReviewWorkspaceGrid">
                        <Grid.RowDefinitions>
                            <!-- Header Row: Student Identity & Actions -->
                            <RowDefinition Height="Auto"/>
                            <!-- Split-Screen Body: Details on Left, Certificate on Right -->
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header Row -->
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Back to Queue Table Button -->
                            <Button x:Name="BtnBackToExamQueueTable"
                                    Grid.Column="0"
                                    Content="&#x2190; Back to Queue"
                                    Style="{DynamicResource BtnSecondary}"
                                    Padding="12,7"
                                    FontSize="12"
                                    Cursor="Hand"
                                    Margin="0,0,16,0"/>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,3">
                                    <TextBlock x:Name="TxtExamReviewStudentName"
                                               Text="Student Name"
                                               FontFamily="IBM Plex Mono, Consolas"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"
                                               Margin="0,0,10,0"/>
                                    <Border x:Name="BadgeExamReviewStatus"
                                            Background="{DynamicResource AccentTintBrush}"
                                            BorderBrush="{DynamicResource AccentBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="8,2"
                                            VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtExamReviewStatus"
                                                   Text="UNDER REVIEW"
                                                   FontFamily="IBM Plex Mono, Consolas"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentBrush}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="TxtExamReviewStudentRoll"
                                           Text="Roll No: 0801CS221000"
                                           FontFamily="IBM Plex Mono, Consolas"
                                           FontSize="12"
                                           Foreground="{DynamicResource MutedBrush}"/>
                            </StackPanel>

                            <!-- Coordinator Action -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnApproveExamOverride"
                                        Content="&#x2713; Accept Certificate Marks"
                                        Style="{DynamicResource BtnPrimary}"
                                        Background="{DynamicResource SageBrush}"
                                        Padding="16,8"
                                        FontSize="12"
                                        Cursor="Hand"/>
                            </StackPanel>
                        </Grid>

                        <!-- Split-Screen Body -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <!-- Sub-Column 1: Student Information & Diagnostics (Width: 350) -->
                                <ColumnDefinition Width="350"/>
                                <ColumnDefinition Width="14"/>
                                <!-- Sub-Column 2: Zoomable Certificate Viewer (Flexible) -->
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Sub-Column 1: Student Details & Diagnostics -->
                            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="0,0,6,0">

                                    <!-- Diagnostics Box -->
                                    <Border Background="{DynamicResource Panel2Brush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="14"
                                            Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="AUDIT DIAGNOSTICS &amp; REMARKS"
                                                       FontFamily="IBM Plex Mono, Consolas"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       Margin="0,0,0,6"/>
                                            <Border Background="{DynamicResource AccentTintBrush}"
                                                    BorderBrush="{DynamicResource AccentBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="10,8"
                                                    Margin="0,0,0,8">
                                                <TextBlock x:Name="TxtExamReviewRemarks"
                                                           Text="Remarks explaining why verification flagged this student."
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           TextWrapping="Wrap"
                                                           LineHeight="17"/>
                                            </Border>
                                            <TextBlock Text="Audit comparing declared values from the Google Form response against the certificate on the right."
                                                       FontSize="11"
                                                       Foreground="{DynamicResource MutedBrush}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Academic Comparison Card (Declared vs Certificate) -->
                                    <Border Background="{DynamicResource Panel2Brush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="14"
                                            Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="ACADEMIC MARKS COMPARISON"
                                                       FontFamily="IBM Plex Mono, Consolas"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource MutedBrush}"
                                                       Margin="0,0,0,10"/>

                                            <!-- Comparison Table Header -->
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="CRITERIA" FontSize="9" FontWeight="Bold" FontFamily="IBM Plex Mono" Foreground="{DynamicResource MutedBrush}"/>
                                                <TextBlock Grid.Column="1" Text="DECLARED" FontSize="9" FontWeight="Bold" FontFamily="IBM Plex Mono" Foreground="{DynamicResource MutedBrush}"/>
                                                <TextBlock Grid.Column="2" Text="CERTIFICATE" FontSize="9" FontWeight="Bold" FontFamily="IBM Plex Mono" Foreground="{DynamicResource AccentBrush}"/>
                                            </Grid>

                                            <!-- Row 1: Course -->
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Course" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="TxtCmpDeclCourse" Grid.Column="1" Text="&#x2014;" FontSize="11" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" Margin="0,0,4,0"/>
                                                <TextBlock x:Name="TxtCmpCertCourse" Grid.Column="2" Text="&#x2014;" FontSize="11" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap"/>
                                            </Grid>

                                            <!-- Row 2: Candidate Name -->
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Name" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="TxtCmpDeclName" Grid.Column="1" Text="&#x2014;" FontSize="11" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" Margin="0,0,4,0"/>
                                                <TextBlock x:Name="TxtCmpCertName" Grid.Column="2" Text="&#x2014;" FontSize="11" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap"/>
                                            </Grid>

                                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,4,0,8"/>

                                            <!-- Row 3: Assignment /25 -->
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Assign (/25)" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="TxtCmpDeclAssign" Grid.Column="1" Text="&#x2014;" FontFamily="IBM Plex Mono" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                                <TextBlock x:Name="TxtCmpCertAssign" Grid.Column="2" Text="&#x2014;" FontFamily="IBM Plex Mono" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                            </Grid>

                                            <!-- Row 4: Exam /75 -->
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Exam (/75)" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="TxtCmpDeclExam" Grid.Column="1" Text="&#x2014;" FontFamily="IBM Plex Mono" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                                <TextBlock x:Name="TxtCmpCertExam" Grid.Column="2" Text="&#x2014;" FontFamily="IBM Plex Mono" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                            </Grid>

                                            <!-- Row 5: Total /100 -->
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Total (/100)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="TxtCmpDeclTotal" Grid.Column="1" Text="&#x2014;" FontFamily="IBM Plex Mono" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                                                <TextBlock x:Name="TxtCmpCertTotal" Grid.Column="2" Text="&#x2014;" FontFamily="IBM Plex Mono" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                            </Grid>

                                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,8"/>

                                            <!-- Row 6: Roll No & Credits -->
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="NPTEL Roll No" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                                                <TextBlock x:Name="TxtCmpCertRoll" Grid.Column="1" Text="&#x2014;" FontFamily="IBM Plex Mono" FontSize="11" Foreground="{DynamicResource TextBrush}"/>
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Credits" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                                                <TextBlock x:Name="TxtCmpCertCredits" Grid.Column="1" Text="&#x2014;" FontFamily="IBM Plex Mono" FontSize="11" Foreground="{DynamicResource TextBrush}"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Submission Record Box -->
                                    <Border Background="{DynamicResource Panel2Brush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="14"
                                            Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="SUBMISSION RECORD"
                                                       FontFamily="IBM Plex Mono, Consolas"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource MutedBrush}"
                                                       Margin="0,0,0,10"/>

                                            <TextBlock Text="Email Address" FontSize="10" Foreground="{DynamicResource MutedBrush}"/>
                                            <TextBlock x:Name="TxtExamReviewEmail" Text="&#x2014;" FontSize="12" Foreground="{DynamicResource TextBrush}" Margin="0,2,0,8"/>

                                            <TextBlock Text="Submission Timestamp" FontSize="10" Foreground="{DynamicResource MutedBrush}"/>
                                            <TextBlock x:Name="TxtExamReviewTimestamp" Text="&#x2014;" FontSize="12" Foreground="{DynamicResource TextBrush}" Margin="0,2,0,8"/>

                                            <TextBlock Text="Certificate URL (Drive)" FontSize="10" Foreground="{DynamicResource MutedBrush}"/>
                                            <TextBlock x:Name="TxtExamReviewCertUrl" Text="&#x2014;" FontSize="11" Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,6" TextWrapping="Wrap"/>

                                            <Button x:Name="BtnOpenExamDriveLink"
                                                    Content="Open Drive Link"
                                                    Style="{DynamicResource BtnSecondary}"
                                                    HorizontalAlignment="Left"
                                                    Padding="10,5"
                                                    FontSize="11"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Manual Certificate Attachment Card -->
                                    <Border Background="#1C2420"
                                            BorderBrush="{DynamicResource SageBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="14"
                                            Margin="0,0,0,12">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <Border Background="{DynamicResource SageTintBrush}"
                                                        BorderBrush="{DynamicResource SageBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="6,2"
                                                        Margin="0,0,8,0">
                                                    <TextBlock Text="MANUAL OVERRIDE"
                                                               FontFamily="IBM Plex Mono, Consolas"
                                                               FontSize="9"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource SageBrush}"/>
                                                </Border>
                                                <TextBlock Text="ATTACH CERTIFICATE FILE"
                                                           FontFamily="IBM Plex Mono, Consolas"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="Attach a replacement PDF or image certificate received directly from the student. The system will immediately re-run OCR and update this card."
                                                       FontSize="11"
                                                       Foreground="{DynamicResource MutedBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,10"/>
                                            <Button x:Name="BtnAttachLocalExamCert"
                                                    Content="Attach &amp; Re-verify Certificate..."
                                                    Style="{DynamicResource BtnPrimary}"
                                                    Background="{DynamicResource SageBrush}"
                                                    HorizontalAlignment="Left"
                                                    Padding="14,7"
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Cursor="Hand"/>
                                        </StackPanel>
                                    </Border>

                                </StackPanel>
                            </ScrollViewer>

                            <!-- Sub-Column 2: Zoomable Certificate Viewer -->
                            <Border Grid.Column="2"
                                    Background="{DynamicResource Panel2Brush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <!-- Viewer Toolbar -->
                                        <RowDefinition Height="Auto"/>
                                        <!-- Viewer Canvas -->
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- Toolbar -->
                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="STUDENT CERTIFICATE"
                                                       FontFamily="IBM Plex Mono, Consolas"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource MutedBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,10,0"/>
                                            <Border Background="{DynamicResource PanelBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="6,2"
                                                    VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtExamCertStatusBadge"
                                                           Text="Saved"
                                                           FontFamily="IBM Plex Mono, Consolas"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource SageBrush}"/>
                                            </Border>
                                        </StackPanel>

                                        <!-- Zoom & File Controls -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button x:Name="BtnExamZoomOut"
                                                    Content="-"
                                                    ToolTip="Zoom Out"
                                                    Style="{DynamicResource BtnSecondary}"
                                                    Padding="8,3"
                                                    FontSize="12"
                                                    Margin="0,0,4,0"/>
                                            <Border Background="{DynamicResource PanelBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="8,3"
                                                    Margin="0,0,4,0">
                                                <TextBlock x:Name="TxtExamZoomLevel"
                                                           Text="100%"
                                                           FontFamily="IBM Plex Mono, Consolas"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextBrush}"/>
                                            </Border>
                                            <Button x:Name="BtnExamZoomIn"
                                                    Content="+"
                                                    ToolTip="Zoom In"
                                                    Style="{DynamicResource BtnSecondary}"
                                                    Padding="8,3"
                                                    FontSize="12"
                                                    Margin="0,0,8,0"/>
                                            <Button x:Name="BtnExamZoomFit"
                                                    Content="Fit"
                                                    ToolTip="Fit to Viewport"
                                                    Style="{DynamicResource BtnSecondary}"
                                                    Padding="10,4"
                                                    FontSize="11"
                                                    Margin="0,0,8,0"/>
                                            <Button x:Name="BtnOpenExamCertFile"
                                                    Content="&#x2197; Open File"
                                                    ToolTip="Open in default system viewer"
                                                    Style="{DynamicResource BtnSecondary}"
                                                    Padding="12,4"
                                                    FontSize="11"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Canvas Viewport -->
                                    <Grid Grid.Row="1">
                                        <!-- Active Scrollable Zoom Image -->
                                        <ScrollViewer x:Name="ExamCertScrollViewer"
                                                      HorizontalScrollBarVisibility="Auto"
                                                      VerticalScrollBarVisibility="Auto"
                                                      Background="#10100E">
                                            <Image x:Name="ImgExamCertViewer"
                                                   Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="HighQuality">
                                                <Image.LayoutTransform>
                                                    <ScaleTransform x:Name="ExamCertZoomScale" ScaleX="1.0" ScaleY="1.0"/>
                                                </Image.LayoutTransform>
                                            </Image>
                                        </ScrollViewer>

                                        <!-- Missing / Unreadable Certificate Placeholder -->
                                        <Border x:Name="ExamCertMissingPanel"
                                                Background="#141412"
                                                Visibility="Collapsed">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="&#x26A0;"
                                                           FontSize="36"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,0,0,8"/>
                                                <TextBlock Text="No Certificate File on Disk"
                                                           FontFamily="IBM Plex Mono, Consolas"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,0,0,4"/>
                                                <TextBlock Text="The certificate file has not been imported or downloaded to data/Courses/&lt;Course&gt;/certificates/."
                                                           FontSize="12"
                                                           Foreground="{DynamicResource MutedBrush}"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,0,0,16"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>

                        </Grid>
                    </Grid>
                </Border>
            </Grid>

        </Grid>
    </Grid>
</UserControl>
